option(
  'measurement',
  type : 'boolean',
  value : false,
  description : 'Measurement build: a call to an unimplemented entry point ' +
                'that returns void aborts the process instead of being ' +
                'logged and skipped.',
)

option(
  'unified_api12_lab',
  type : 'boolean',
  value : false,
  description : 'Private Vulkan 1.2 and SPIR-V 1.5 validation configuration.',
)

option('unified_api13_lab', type : 'boolean', value : false,
  description : 'Private Vulkan 1.3 and SPIR-V 1.6 validation on Mali-G52, Mali-G57 and Mali-G615')

option('unified_geometry_lab', type : 'boolean', value : false,
  description : 'Enable the experimental CSF geometry shader path')

option('unified_tessellation_lab', type : 'boolean', value : false,
  description : 'Enable the experimental CSF TCS/TES path for direct patch draws')
option('unified_validation_lab', type : 'boolean', value : false,
       description : 'Opt-in maintenance5 and pipeline robustness validation build')
